+            lineTo(carScreenX - max(11f, width * 0.024f), carScreenY + max(14f, width * 0.030f))
+            lineTo(carScreenX, carScreenY + max(7f, width * 0.015f))
+            lineTo(carScreenX + max(11f, width * 0.024f), carScreenY + max(14f, width * 0.030f))
+            close()
+        }
+        canvas.drawPath(marker, paint)
+        canvas.restore()
+
+        paint.color = Color.argb(205, 22, 25, 28)
+        canvas.drawRoundRect(
+            RectF(width * 0.04f, height * 0.04f, width * 0.54f, height * 0.14f),
+            14f, 14f, paint
+        )
         paint.textAlign = Paint.Align.CENTER
         paint.isFakeBoldText = true
-        paint.color = Color.rgb(35, 38, 40)
-        paint.textSize = max(24f, height * 0.055f)
-        canvas.drawText("KAKAO NAVI", width * 0.5f, height * 0.12f, paint)
+        paint.color = Color.WHITE
+        paint.textSize = max(15f, height * 0.035f)
+        canvas.drawText(if (location == null) "GPS WAIT" else "OSM · GPS", width * 0.29f, height * 0.105f, paint)
         paint.isFakeBoldText = false
-        paint.color = Color.rgb(95, 99, 102)
-        paint.textSize = max(16f, height * 0.030f)
-        canvas.drawText("APP KEY REQUIRED", width * 0.5f, height * 0.18f, paint)
+        paint.textAlign = Paint.Align.LEFT
+
+        paint.color = Color.argb(190, 255, 255, 255)
+        paint.textSize = max(10f, height * 0.022f)
+        canvas.drawText("© OpenStreetMap contributors", width * 0.03f, height * 0.97f, paint)
+    }
+
+    private fun requestTile(zoom: Int, x: Int, y: Int, key: String) {
+        if (!requestedTiles.add(key)) return
+        val request = Request.Builder()
+            .url("https://tile.openstreetmap.org/$zoom/$x/$y.png")
+            .header("User-Agent", "CarrotHUD/1.1 personal Android Auto prototype")
+            .build()
+        httpClient.newCall(request).enqueue(object : Callback {
+            override fun onFailure(call: Call, e: java.io.IOException) {
+                requestedTiles.remove(key)
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                response.use {
+                    if (!it.isSuccessful) return
+                    val bytes = it.body?.bytes() ?: return
+                    val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size) ?: return
+                    synchronized(tileCache) { tileCache.put(key, bitmap) }
+                }
+                requestedTiles.remove(key)
+            }
+        })
     }
 
     /** All geometry uses normalized screen coordinates, so wide OEM surfaces never stretch a bitmap. */
