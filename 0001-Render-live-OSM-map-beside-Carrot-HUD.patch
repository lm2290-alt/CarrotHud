diff --git a/app/src/main/java/com/example/carrothud/KakaoNavigationPane.kt b/app/src/main/java/com/example/carrothud/KakaoNavigationPane.kt
new file mode 100644
index 0000000..e8c1972
--- /dev/null
+++ b/app/src/main/java/com/example/carrothud/KakaoNavigationPane.kt
@@ -0,0 +1,163 @@
+package com.example.carrothud
+
+import android.Manifest
+import android.app.Application
+import android.content.Context
+import android.content.pm.PackageManager
+import android.graphics.Color
+import android.location.LocationManager
+import android.os.Handler
+import android.os.Looper
+import android.widget.FrameLayout
+import android.widget.TextView
+import com.kakaomobility.knsdk.KNSDK
+import com.kakaomobility.knsdk.KNLanguageType
+import com.kakaomobility.knsdk.KNRoutePriority
+import com.kakaomobility.knsdk.common.objects.KNPOI
+import com.kakaomobility.knsdk.ui.view.KNNaviView
+import java.lang.reflect.Proxy
+
+/** Official embedded navigation UI. An authentication failure is never replaced by OSM. */
+class KakaoNavigationPane(context: Context) : FrameLayout(context) {
+    private val main=Handler(Looper.getMainLooper())
+    private val prefs=context.getSharedPreferences("navigation",Context.MODE_PRIVATE)
+    private val status=TextView(context).apply {
+        text="카카오 내비 연결 중…"; textSize=18f; setTextColor(Color.DKGRAY)
+        gravity=android.view.Gravity.CENTER; setBackgroundColor(Color.WHITE)
+    }
+    private var closed=false
+    private var view: KNNaviView?=null
+    private val delegates=mutableListOf<Any>()
+    private val timeout=Runnable { if(view==null && !closed) status.text="카카오 응답 대기 중\n네트워크와 앱 키 등록을 확인하세요" }
+
+    init {
+        addView(status,LayoutParams(-1,-1))
+        val key=prefs.getString("native_key","").orEmpty()
+        if(key.isBlank()) status.text="휴대폰 앱에서 카카오 내비 키를 설정하세요"
+        else if(context.checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION)!=PackageManager.PERMISSION_GRANTED)
+            status.text="휴대폰 앱에 정확한 위치 권한을 허용하세요"
+        else {
+            main.postDelayed(timeout,20000)
+            try {
+                install(context.applicationContext as Application)
+                KNSDK.initializeWithAppKey(key,"1.2.0-preview",null,KNLanguageType.KNLanguageType_KOREAN) { error ->
+                    main.post {
+                        if(!closed) {
+                            if(error!=null) fail("카카오 인증·초기화 실패\n패키지명과 현재 APK 키 해시를 확인하세요")
+                            else runCatching { startNavigation() }.onFailure { fail("카카오 화면 초기화 실패\n휴대폰에서 설정을 확인한 뒤 다시 연결하세요") }
+                        }
+                    }
+                }
+            } catch (_: Exception) { fail("카카오 SDK 초기화 실패") }
+        }
+    }
+
+    private fun fail(message: String) {
+        main.removeCallbacks(timeout)
+        status.text=message
+        status.visibility=VISIBLE
+        status.bringToFront()
+    }
+
+    private fun startNavigation() {
+        val guidance=checkNotNull(KNSDK.sharedGuidance())
+        val nav=KNNaviView(context)
+        view=nav
+        addView(nav,0,LayoutParams(-1,-1))
+        // The SDK view exposes callbacks but does not implement the delegate interfaces.
+        // Bind each public delegate's matching callback, validating every method up front.
+        for(name in listOf("setGuideStateDelegate","setLocationGuideDelegate","setRouteGuideDelegate",
+            "setSafetyGuideDelegate","setVoiceGuideDelegate","setCitsGuideDelegate")) {
+            val setter=guidance.javaClass.methods.single { it.name==name && it.parameterCount==1 }
+            val type=setter.parameterTypes[0]
+            val methods=type.methods.associateWith { method ->
+                nav.javaClass.methods.firstOrNull { it.name==method.name && it.parameterTypes.contentEquals(method.parameterTypes) }
+                    ?: nav.javaClass.methods.firstOrNull { method.name=="guidanceGuideEnded" && it.name==method.name && it.parameterCount==2 }
+                    ?: error("Unsupported Kakao callback: ${method.name}")
+            }
+            val proxy=Proxy.newProxyInstance(type.classLoader,arrayOf(type)) { instance,method,args ->
+                when(method.name) {
+                    "toString" -> "CarrotNavigationDelegate"
+                    "hashCode" -> System.identityHashCode(instance)
+                    "equals" -> instance === args?.firstOrNull()
+                    else -> {
+                        val target=checkNotNull(methods[method])
+                        val values=args ?: emptyArray()
+                        if(target.parameterCount==values.size) target.invoke(nav,*values)
+                        else target.invoke(nav,*values,false)
+                    }
+                }
+            }
+            delegates.add(proxy)
+            setter.invoke(guidance,proxy)
+        }
+        KNSDK.handleCarInterfaceConnected()
+        KNSDK.handleWillEnterForeground()
+        KNSDK.handleDidBecomeActive()
+        val latitude=prefs.getString("goal_lat","")?.toDoubleOrNull()
+        val longitude=prefs.getString("goal_lon","")?.toDoubleOrNull()
+        val priority=KNRoutePriority.KNRoutePriority_Recommand
+        if(latitude==null || longitude==null) {
+            nav.initWithGuidance(guidance,null,priority,0)
+            status.visibility=GONE
+            main.removeCallbacks(timeout)
+            return
+        }
+        val manager=context.getSystemService(Context.LOCATION_SERVICE) as LocationManager
+        @Suppress("MissingPermission")
+        val location=manager.getProviders(true).mapNotNull { provider ->
+            runCatching { manager.getLastKnownLocation(provider) }.getOrNull()
+        }.filter { android.os.SystemClock.elapsedRealtimeNanos()-it.elapsedRealtimeNanos < 120_000_000_000L }
+            .maxByOrNull { it.elapsedRealtimeNanos }
+        if(location==null) { fail("현재 위치 수신 대기\nGPS 수신 후 AA를 다시 연결하세요"); return }
+        val start=KNSDK.convertWGS84ToKATEC(location.longitude,location.latitude)
+        val goal=KNSDK.convertWGS84ToKATEC(longitude,latitude)
+        val startPoi=KNPOI("현재 위치",start.x.toInt(),start.y.toInt())
+        val goalPoi=KNPOI(prefs.getString("goal_name","목적지").orEmpty(),goal.x.toInt(),goal.y.toInt())
+        KNSDK.makeTripWithStart(startPoi,goalPoi,null,null) { error,trip ->
+            main.post {
+                if(!closed) {
+                    if(error!=null || trip==null) fail("카카오 경로 요청 실패\n목적지와 네트워크를 확인하세요")
+                    else trip.routeWithPriority(priority,0) { routeError,_ ->
+                        main.post {
+                            if(!closed) {
+                                if(routeError!=null) fail("카카오 경로 탐색 실패")
+                                else {
+                                    nav.initWithGuidance(guidance,trip,priority,0)
+                                    status.visibility=GONE
+                                    main.removeCallbacks(timeout)
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    fun close() {
+        closed=true
+        main.removeCallbacksAndMessages(null)
+        if(view!=null) {
+            KNSDK.sharedGuidance()?.stop()
+            KNSDK.sharedGuidance()?.apply {
+                guideStateDelegate=null; locationGuideDelegate=null; routeGuideDelegate=null
+                safetyGuideDelegate=null; voiceGuideDelegate=null; citsGuideDelegate=null
+            }
+            KNSDK.handleCarInterfaceDisconnected()
+        }
+        delegates.clear()
+        removeAllViews()
+        view=null
+    }
+
+    companion object {
+        private var installed=false
+        @Synchronized private fun install(application: Application) {
+            if(!installed) {
+                KNSDK.install(application,"${application.filesDir}/kakao-navigation")
+                installed=true
+            }
+        }
+    }
+}
