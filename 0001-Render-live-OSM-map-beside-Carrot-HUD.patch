@@ -0,0 +1,21 @@
+package com.example.carrothud;
+
+/** Distance-driven road markings, independent of the Android frame scheduler. */
+public final class RoadMotion {
+    private long previousMillis = -1;
+    private float phase = 0f;
+
+    public float advance(long nowMillis, float speedKph, boolean connected) {
+        float seconds = previousMillis < 0 ? 0f
+                : Math.max(0f, Math.min(0.1f, (nowMillis - previousMillis) / 1000f));
+        previousMillis = nowMillis;
+        float speed = connected && Float.isFinite(speedKph) && speedKph >= 0.5f
+                ? speedKph : 0f;
+        phase = (phase + seconds * speed / 3.6f / 35f) % 1f;
+        return phase;
+    }
+
+    public void pause() {
+        previousMillis = -1;
+    }
+}
diff --git a/app/src/main/java/com/example/carrothud/VehicleMesh.java b/app/src/main/java/com/example/carrothud/VehicleMesh.java
new file mode 100644
index 0000000..e59369a
--- /dev/null
+++ b/app/src/main/java/com/example/carrothud/VehicleMesh.java
@@ -0,0 +1,133 @@
+package com.example.carrothud;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Actual XYZ mesh, not a pre-rendered image. Procedural DE-style crossover prototype.
+ * Not an OEM CAD model. Coordinates are metres: X right, Y up, Z forward.
+ */
+public final class VehicleMesh {
+    public static final int BODY = 0, GLASS = 1, TRIM = 2, WHEEL = 3,
+            ALLOY = 4, TAIL = 5, LEFT_SIGNAL = 6, RIGHT_SIGNAL = 7;
+    public static final class Face {
+        public final double[][] vertices;
+        public final int material;
+        Face(int material, double[]... vertices) {
+            this.material = material;
+            this.vertices = vertices;
+        }
+    }
+    public static final class ProjectedFace {
+        public final double[] x, y;
+        public final double depth, light;
+        public final int material;
+        ProjectedFace(double[] x, double[] y, double depth, double light, int material) {
+            this.x = x; this.y = y; this.depth = depth; this.light = light;
+            this.material = material;
+        }
+    }
+    private final List<Face> faces = new ArrayList<>();
+
+    public VehicleMesh(boolean crossover) {
+        double length = crossover ? 4.375 : 4.7;
+        double rear = -length / 2, front = length / 2;
+        // Rounded shoulder sections, black lower cladding, white body panels.
+        hull(new double[]{rear, rear+.25, front-.35, front},
+                new double[]{.77,.90,.88,.73}, .38,.58, TRIM);
+        hull(new double[]{rear, rear+.25, front-.35, front},
+                new double[]{.77,.90,.88,.73}, .58,1.08, BODY);
+        double roof = crossover ? 1.57 : 1.39;
+        double[] a = {-0.77,1.08,rear+.20}, b = {.77,1.08,rear+.20};
+        double[] c = {-.65,roof,rear+.85}, d = {.65,roof,rear+.85};
+        double[] e = {-.65,roof,.48}, f = {.65,roof,.48};
+        double[] g = {-.78,1.08,1.25}, h = {.78,1.08,1.25};
+        face(GLASS,a,b,d,c); face(BODY,c,d,f,e); face(GLASS,e,f,h,g);
+        face(GLASS,a,c,e,g); face(GLASS,b,h,f,d);
+        // Narrow pillars and roof rails, distinct rear spoiler on the crossover.
+        box(-.70,.70,roof,roof+.045,rear+.81,.53,BODY);
+        box(-.75,.75,roof-.06,roof+.025,rear+.73,rear+.90,TRIM);
+        for (double side : new double[]{-1,1}) {
+            double x = side*.735;
+            box(x-.035,x+.035,1.1,roof-.02,-.45,-.34,TRIM);
+            box(side*.91-.09,side*.91+.09,1.03,1.15,.52,.78,BODY);
+            for (double z : new double[]{rear+.72,front-.76}) wheel(side*.88,.35,z);
+        }
+        // Horizontal DE-style tail lamps, signals on the rear bumper (no floating arrows).
+        box(-.76,-.34,.91,1.03,rear-.025,rear+.02,TAIL);
+        box(.34,.76,.91,1.03,rear-.025,rear+.02,TAIL);
+        box(-.74,-.49,.54,.63,rear-.03,rear+.01,LEFT_SIGNAL);
+        box(.49,.74,.54,.63,rear-.03,rear+.01,RIGHT_SIGNAL);
+        box(-.25,.25,.66,.78,rear-.03,rear,TRIM);
+        box(-.62,.62,.36,.43,rear-.04,rear+.05,ALLOY);
+    }
+    private void face(int material,double[]... vertices) { faces.add(new Face(material,vertices)); }
+    private void box(double x0,double x1,double y0,double y1,double z0,double z1,int m) {
+        double[] a={x0,y0,z0},b={x1,y0,z0},c={x1,y1,z0},d={x0,y1,z0};
+        double[] e={x0,y0,z1},f={x1,y0,z1},g={x1,y1,z1},h={x0,y1,z1};
+        face(m,a,b,c,d); face(m,e,h,g,f); face(m,a,d,h,e);
+        face(m,b,f,g,c); face(m,d,c,g,h); face(m,a,e,f,b);
+    }
+    private void hull(double[] zs,double[] widths,double low,double high,int material) {
+        double[][] prev=null;
+        for(int k=0;k<zs.length;k++) {
+            double w=widths[k], z=zs[k];
+            double[][] ring={{-w*.85,low,z},{w*.85,low,z},{w,low+.10,z},
+                {w,high-.12,z},{w*.84,high,z},{-w*.84,high,z},
+                {-w,high-.12,z},{-w,low+.10,z}};
+            if(prev==null) face(material,ring);
+            else for(int i=0;i<8;i++) face(material,prev[i],prev[(i+1)%8],ring[(i+1)%8],ring[i]);
+            prev=ring;
+        }
+        face(material,prev);
+    }
+    private void wheel(double x,double y,double z) {
+        int n=16;
+        double outer=x+Math.signum(x)*.11, inner=x-Math.signum(x)*.11;
+        double[][] cap=new double[n][];
+        for(int i=0;i<n;i++) {
+            double t=i*2*Math.PI/n, u=(i+1)*2*Math.PI/n;
+            double[] a={outer,y+Math.sin(t)*.33,z+Math.cos(t)*.33};
+            double[] b={outer,y+Math.sin(u)*.33,z+Math.cos(u)*.33};
+            cap[i]=a;
+            face(WHEEL,a,b,new double[]{inner,b[1],b[2]},new double[]{inner,a[1],a[2]});
+        }
+        face(WHEEL,cap);
+        double[][] rim=new double[n][];
+        for(int i=0;i<n;i++) {
+            double t=i*2*Math.PI/n;
+            rim[i]=new double[]{outer+Math.signum(x)*.006,y+Math.sin(t)*.22,z+Math.cos(t)*.22};
+        }
+        face(ALLOY,rim);
+    }
+
+    /** Perspective projection with a fixed rear camera. One uniform scale preserves shape. */
+    public List<ProjectedFace> project(double yawDegrees) {
+        double yaw=Math.toRadians(Math.max(-12,Math.min(12,yawDegrees)));
+        double sy=Math.sin(yaw),cy=Math.cos(yaw), pitch=.42;
+        List<ProjectedFace> result=new ArrayList<>();
+        for(Face face:faces) {
+            int n=face.vertices.length;
+            double[] xs=new double[n],ys=new double[n];
+            double[][] rotated=new double[n][3];
+            double depth=0;
+            for(int i=0;i<n;i++) {
+                double[] v=face.vertices[i];
+                double x=v[0]*cy+v[2]*sy,z=-v[0]*sy+v[2]*cy,y=v[1]-.7;
+                rotated[i]=new double[]{x,y,z};
+                double cz=z*Math.cos(pitch)-y*Math.sin(pitch)+8;
+                xs[i]=x/cz; ys[i]=-(y*Math.cos(pitch)+z*Math.sin(pitch))/cz;
+                depth+=cz/n;
+            }
+            double[] a=rotated[0],b=rotated[1],c=rotated[2];
+            double ux=b[0]-a[0],uy=b[1]-a[1],uz=b[2]-a[2];
+            double vx=c[0]-a[0],vy=c[1]-a[1],vz=c[2]-a[2];
+            double nx=uy*vz-uz*vy,ny=uz*vx-ux*vz,nz=ux*vy-uy*vx;
+            double norm=Math.sqrt(nx*nx+ny*ny+nz*nz);
+            double light=norm<1e-8?.8:.64+.36*Math.abs((nx*.3+ny*.8-nz*.5)/norm);
+            result.add(new ProjectedFace(xs,ys,depth,Math.min(1,light),face.material));
+        }
+        result.sort(Comparator.comparingDouble((ProjectedFace f)->f.depth).reversed());
+        return result;
+    }
+}
