@@ -0,0 +1,67 @@
+package com.example.carrothud
+
+import android.app.Presentation
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.hardware.display.DisplayManager
+import android.hardware.display.VirtualDisplay
+import android.os.Bundle
+import android.view.View
+import android.view.WindowManager
+import android.widget.LinearLayout
+import androidx.car.app.SurfaceContainer
+
+/** Own-app views only. Does not capture the phone or embed another application's window. */
+class CarSurfacePresentation(
+    private val context: Context,
+    private val drawHud: (Canvas,Float,Float)->Unit
+) {
+    private var display: VirtualDisplay? = null
+    private var presentation: Presentation? = null
+    private var navigation: KakaoNavigationPane? = null
+
+    fun attach(container: SurfaceContainer) {
+        close()
+        val surface=requireNotNull(container.surface)
+        require(surface.isValid && container.width>0 && container.height>0)
+        val manager=context.getSystemService(Context.DISPLAY_SERVICE) as DisplayManager
+        val target=checkNotNull(manager.createVirtualDisplay(
+            "CarrotHUD navigation",container.width,container.height,
+            container.dpi.coerceAtLeast(120),surface,
+            DisplayManager.VIRTUAL_DISPLAY_FLAG_OWN_CONTENT_ONLY or DisplayManager.VIRTUAL_DISPLAY_FLAG_PRESENTATION
+        ))
+        display=target
+        val p=object: Presentation(context,target.display,android.R.style.Theme_Material_Light_NoActionBar) {
+            override fun onCreate(savedInstanceState: Bundle?) {
+                super.onCreate(savedInstanceState)
+                window?.addFlags(WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED)
+                val row=LinearLayout(this.context).apply {
+                    orientation=LinearLayout.HORIZONTAL
+                    setBackgroundColor(Color.WHITE)
+                }
+                navigation=KakaoNavigationPane(this.context)
+                row.addView(navigation,LinearLayout.LayoutParams(0,-1,1f))
+                row.addView(object: View(this.context) {
+                    override fun onDraw(canvas: Canvas) {
+                        drawHud(canvas,width.toFloat(),height.toFloat())
+                        postInvalidateDelayed(33)
+                    }
+                },LinearLayout.LayoutParams(0,-1,1f))
+                setContentView(row)
+            }
+        }
+        presentation=p
+        p.show()
+        p.window?.setLayout(-1,-1)
+    }
+
+    fun close() {
+        navigation?.close()
+        navigation=null
+        presentation?.dismiss()
+        presentation=null
+        display?.release()
+        display=null
+    }
+}
