+++ b/app/src/main/java/com/example/carrothud/VehicleMeshRenderer.kt
@@ -0,0 +1,62 @@
+package com.example.carrothud
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import kotlin.math.min
+
+/** Software 3D rasterizer for the AA Canvas; no offscreen screenshots or sprites. */
+class VehicleMeshRenderer {
+    private val crossover = VehicleMesh(true)
+    private val sedan = VehicleMesh(false)
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val path = Path()
+    private var cachedYaw = Double.NaN
+    private var egoFaces = crossover.project(0.0)
+    private val leadFaces = sedan.project(0.0)
+
+    fun draw(canvas: Canvas, bounds: RectF, ego: Boolean, yaw: Float,
+             leftSignal: Boolean, rightSignal: Boolean) {
+        val angle = (yaw * 2).toInt() / 2.0
+        if (ego && angle != cachedYaw) {
+            egoFaces = crossover.project(angle)
+            cachedYaw = angle
+        }
+        val faces = if (ego) egoFaces else leadFaces
+        val minX = faces.minOf { it.x.minOrNull()!! }
+        val maxX = faces.maxOf { it.x.maxOrNull()!! }
+        val minY = faces.minOf { it.y.minOrNull()!! }
+        val maxY = faces.maxOf { it.y.maxOrNull()!! }
+        val scale = min(bounds.width() / (maxX-minX), bounds.height() / (maxY-minY))
+        val cx = (minX+maxX)/2
+        val cy = (minY+maxY)/2
+        paint.style = Paint.Style.FILL
+        for (face in faces) {
+            path.rewind()
+            for (i in face.x.indices) {
+                val x = (bounds.centerX()+(face.x[i]-cx)*scale).toFloat()
+                val y = (bounds.centerY()+(face.y[i]-cy)*scale).toFloat()
+                if (i == 0) path.moveTo(x,y) else path.lineTo(x,y)
+            }
+            path.close()
+            val base = when (face.material) {
+                VehicleMesh.BODY -> if (ego) Color.rgb(247,248,248) else Color.rgb(137,145,151)
+                VehicleMesh.GLASS -> Color.rgb(35,46,55)
+                VehicleMesh.TRIM -> Color.rgb(43,47,50)
+                VehicleMesh.WHEEL -> Color.rgb(23,25,27)
+                VehicleMesh.ALLOY -> Color.rgb(165,172,177)
+                VehicleMesh.TAIL -> Color.rgb(165,23,29)
+                VehicleMesh.LEFT_SIGNAL -> if (leftSignal) Color.rgb(255,171,14) else Color.rgb(88,53,25)
+                VehicleMesh.RIGHT_SIGNAL -> if (rightSignal) Color.rgb(255,171,14) else Color.rgb(88,53,25)
+                else -> Color.GRAY
+            }
+            val light = if ((face.material == VehicleMesh.LEFT_SIGNAL && leftSignal) ||
+                (face.material == VehicleMesh.RIGHT_SIGNAL && rightSignal)) 1.0 else face.light
+            paint.color = Color.rgb((Color.red(base)*light).toInt(),
+                (Color.green(base)*light).toInt(),(Color.blue(base)*light).toInt())
+            canvas.drawPath(path,paint)
+        }
+    }
+}
