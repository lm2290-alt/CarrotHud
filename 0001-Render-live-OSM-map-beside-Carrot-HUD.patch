--- /dev/null
+++ b/tests/VehicleMeshCheck.java
@@ -0,0 +1,24 @@
+import com.example.carrothud.VehicleMesh;
+public class VehicleMeshCheck {
+    public static void main(String[] args) {
+        for (boolean ego : new boolean[]{true,false}) {
+            VehicleMesh mesh = new VehicleMesh(ego);
+            for (double yaw : new double[]{-12,0,12}) {
+                double previous=Double.POSITIVE_INFINITY;
+                int faces=0;
+                for(VehicleMesh.ProjectedFace f:mesh.project(yaw)) {
+                    if(f.depth>previous) throw new AssertionError("depth sorting");
+                    previous=f.depth;
+                    if(f.light<0 || f.light>1) throw new AssertionError("lighting");
+                    for(int i=0;i<f.x.length;i++) {
+                        if(!Double.isFinite(f.x[i]) || !Double.isFinite(f.y[i]))
+                            throw new AssertionError("invalid projection");
+                    }
+                    faces++;
+                }
+                if(faces<100) throw new AssertionError("missing mesh");
+            }
+        }
+        System.out.println("Vehicle mesh checks passed");
+    }
+}
