+package com.example.carrothud
+
+import android.app.Activity
+import android.os.Bundle
+import android.content.Context
+import android.content.pm.PackageManager
+import android.text.InputType
+import android.util.Base64
+import android.widget.*
+import java.security.MessageDigest
+
+/** Phone-only setup. Never request text input from the driver on the AA surface. */
+class NavigationSettingsActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val prefs = getSharedPreferences("navigation",Context.MODE_PRIVATE)
+        val layout = LinearLayout(this).apply {
+            orientation=LinearLayout.VERTICAL
+            setPadding(32,32,32,32)
+        }
+        setContentView(ScrollView(this).apply { addView(layout) })
+        fun label(value: String) { layout.addView(TextView(this).apply { text=value; textSize=17f; setPadding(0,16,0,8) }) }
+        fun field(hintText: String, stored: String, secret: Boolean=false): EditText {
+            return EditText(this).apply {
+                hint=hintText; setSingleLine(true)
+                inputType= if(secret) InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+                    else InputType.TYPE_CLASS_TEXT
+                setText(prefs.getString(stored,""))
+                layout.addView(this)
+            }
+        }
+        label("카카오 내비 · 실험 버전 설정")
+        label("정차 후 설정하세요. AA에서 동작 여부는 실차 검증이 필요합니다.")
+        val key=field("카카오 네이티브 앱 키","native_key",true)
+        label("등록할 패키지: $packageName")
+        @Suppress("DEPRECATION")
+        val signatures=packageManager.getPackageInfo(packageName,PackageManager.GET_SIGNATURES).signatures
+        val hash=signatures?.firstOrNull()?.let {
+            Base64.encodeToString(MessageDigest.getInstance("SHA-1").digest(it.toByteArray()),Base64.NO_WRAP)
+        } ?: "서명 확인 실패"
+        layout.addView(TextView(this).apply { text="현재 APK 키 해시\n$hash"; setTextIsSelectable(true); textSize=15f })
+        label("아래 목적지는 시험용 좌표 입력입니다. 미입력 시 안전운행 지도만 표시합니다.")
+        val name=field("목적지 이름","goal_name")
+        val lat=field("목적지 위도 (예: 37.5665)","goal_lat")
+        val lon=field("목적지 경도 (예: 126.9780)","goal_lon")
+        val enabled=Switch(this).apply {
+            text="AA 카카오 SDK 분할 화면 사용 (시험용)"
+            isChecked=prefs.getBoolean("enabled",false)
+            layout.addView(this)
+        }
+        layout.addView(Button(this).apply {
+            text="저장"
+            setOnClickListener {
+                val latitude=lat.text.toString().trim()
+                val longitude=lon.text.toString().trim()
+                if(enabled.isChecked && !key.text.toString().trim().matches(Regex("[0-9a-fA-F]{32}"))) {
+                    key.error="네이티브 앱 키를 확인하세요"; return@setOnClickListener
+                }
+                if(latitude.isNotEmpty() || longitude.isNotEmpty()) {
+                    val a=latitude.toDoubleOrNull(); val b=longitude.toDoubleOrNull()
+                    if(a==null || b==null || a !in -90.0..90.0 || b !in -180.0..180.0) {
+                        lat.error="위도·경도를 모두 확인하세요"; return@setOnClickListener
+                    }
+                }
+                prefs.edit().putString("native_key",key.text.toString().trim())
+                    .putString("goal_name",name.text.toString().trim())
+                    .putString("goal_lat",latitude).putString("goal_lon",longitude)
+                    .putBoolean("enabled",enabled.isChecked).apply()
+                Toast.makeText(this@NavigationSettingsActivity,"저장했습니다. AA를 다시 연결하세요.",Toast.LENGTH_LONG).show()
+                finish()
+            }
+        })
+    }
+}
