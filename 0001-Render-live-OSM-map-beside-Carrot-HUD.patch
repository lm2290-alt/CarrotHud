new file mode 100644
index 0000000..b521cc4
--- /dev/null
+++ b/app/src/main/java/com/example/carrothud/RoadMotion.java
@@ -0,0 +1,21 @@
+package com.example.carrothud;
+
+/** Distance-driven road markings, independent of the Android frame scheduler. */
+public final class RoadMotion {
+    private long previousMillis = -1;
+    private float phase = 0f;
+
+    public float advance(long nowMillis, float speedKph, boolean connected) {
+        float seconds = previousMillis < 0 ? 0f
+                : Math.max(0f, Math.min(0.1f, (nowMillis - previousMillis) / 1000f));
+        previousMillis = nowMillis;
+        float speed = connected && Float.isFinite(speedKph) && speedKph >= 0.5f
+                ? speedKph : 0f;
+        phase = (phase + seconds * speed / 3.6f / 35f) % 1f;
+        return phase;
+    }
+
+    public void pause() {
+        previousMillis = -1;
+    }
+}
diff --git a/tests/RoadMotionCheck.java b/tests/RoadMotionCheck.java
new file mode 100644
index 0000000..f336816
--- /dev/null
+++ b/tests/RoadMotionCheck.java
@@ -0,0 +1,24 @@
+import com.example.carrothud.RoadMotion;
+
+public final class RoadMotionCheck {
+    private static void same(float actual, float expected) {
+        if (Math.abs(actual - expected) > 0.00001f) throw new AssertionError(actual + " != " + expected);
+    }
+    public static void main(String[] args) {
+        RoadMotion motion = new RoadMotion();
+        same(motion.advance(0, 0, true), 0);
+        same(motion.advance(100, 0, true), 0);
+        float moving = motion.advance(200, 36, true);
+        same(moving, 1f / 35f);
+        same(motion.advance(300, 0, true), moving);
+        same(motion.advance(400, 0.3f, true), moving);
+        same(motion.advance(500, 100, false), moving);
+        same(motion.advance(600, Float.NaN, true), moving);
+        same(motion.advance(700, Float.POSITIVE_INFINITY, true), moving);
+        same(motion.advance(800, -1, true), moving);
+        same(motion.advance(900, 72, true), moving + 2f / 35f);
+        motion.pause();
+        same(motion.advance(999999, 72, true), moving + 2f / 35f);
+        System.out.println("PASS: stop, movement, speed change, disconnect, noise, invalid speed, resume");
+    }
+}
