         canvas.drawRect(0f, 0f, width, height, paint)
 
-        paint.color = Color.rgb(206, 210, 205)
-        for (i in 0..7) {
-            val y = height * (i / 7f)
-            canvas.drawRect(0f, y, width, y + max(1f, height * 0.003f), paint)
-        }
-        for (i in 0..5) {
-            val x = width * (i / 5f)
-            canvas.drawRect(x, 0f, x + max(1f, width * 0.004f), height, paint)
+        val location = mapLocation
+        val lat = location?.latitude ?: 37.5665
+        val lon = location?.longitude ?: 126.9780
+        val zoom = 16
+        val tileSize = 256.0
+        val worldSize = tileSize * 2.0.pow(zoom)
+        val centerX = (lon + 180.0) / 360.0 * worldSize
+        val clippedLat = lat.coerceIn(-85.05112878, 85.05112878)
+        val latRad = clippedLat * PI / 180.0
+        val centerY = (1.0 - ln(tan(latRad) + 1.0 / kotlin.math.cos(latRad)) / PI) / 2.0 * worldSize
+        val carScreenX = width * 0.5f
+        val carScreenY = height * 0.64f
+
+        canvas.save()
+        canvas.clipRect(0f, 0f, width, height)
+        for (tx in floor((centerX - width) / tileSize).toInt()..floor((centerX + width) / tileSize).toInt()) {
+            for (ty in floor((centerY - height) / tileSize).toInt()..floor((centerY + height) / tileSize).toInt()) {
+                val tileCount = 1 shl zoom
+                if (ty !in 0 until tileCount) continue
+                val wrappedX = ((tx % tileCount) + tileCount) % tileCount
+                val key = "$zoom/$wrappedX/$ty"
+                val left = (carScreenX + tx * tileSize - centerX).toFloat()
+                val top = (carScreenY + ty * tileSize - centerY).toFloat()
+                val bitmap = synchronized(tileCache) { tileCache.get(key) }
+                if (bitmap != null) {
+                    canvas.drawBitmap(bitmap, null, RectF(left, top, left + 256f, top + 256f), mapPaint)
+                } else {
+                    requestTile(zoom, wrappedX, ty, key)
+                }
+            }
         }
+        canvas.restore()
 
+        // Vehicle position and live GPS heading.
         paint.style = Paint.Style.STROKE
         paint.strokeCap = Paint.Cap.ROUND
-        paint.strokeWidth = max(6f, width * 0.018f)
-        paint.color = Color.rgb(255, 214, 0)
-        val route = Path().apply {
-            moveTo(width * 0.12f, height * 0.82f)
-            cubicTo(width * 0.28f, height * 0.64f, width * 0.34f, height * 0.38f, width * 0.53f, height * 0.47f)
-            cubicTo(width * 0.69f, height * 0.54f, width * 0.72f, height * 0.22f, width * 0.88f, height * 0.14f)
-        }
-        canvas.drawPath(route, paint)
+        paint.strokeWidth = max(4f, width * 0.010f)
